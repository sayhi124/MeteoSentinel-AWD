{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeteoSentinelEventV1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "cityCode",
    "dataVersion",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "cityCode": {
      "type": "string"
    },
    "dataVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}