  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "Reading": {
        "type": "object",
        "required": [
          "cityCode",
          "validAt",
          "fetchedAt",
          "source"
        ],
        "properties": {
          "cityCode": {
            "type": "string"
          },
          "validAt": {
            "type": "string",
            "format": "date-time"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "temperatureC": {
            "type": "number",
            "nullable": true
          },
          "windKmh": {
            "type": "number",
            "nullable": true
          },
          "humidityPct": {
            "type": "number",
            "nullable": true
          },
          "europeanAqi": {
            "type": "number",
            "nullable": true
          },
          "pm25": {
            "type": "number",
            "nullable": true
          },
          "qualityFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "required": [
          "query",
          "cityCode"
        ],
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "cityCode": {
            "type": "string",
            "enum": [
              "TUNIS",
              "SFAX",
              "SOUSSE"
            ]
          },
          "tags": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5
          }
        }
      },
      "RecommendationRequest": {
        "type": "object",
        "required": [
          "cityCode",
          "activityCode",
          "durationHours"
        ],
        "additionalProperties": false,
        "properties": {
          "cityCode": {
            "type": "string",
            "enum": [
              "TUNIS",
              "SFAX",
              "SOUSSE"
            ]
          },
          "activityCode": {
            "type": "string",
            "enum": [
              "WALK",
              "RUN",
              "CYCLE"
            ]
          },
          "durationHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "startsAfter": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Recommendation": {
        "type": "object",
        "required": [
          "startsAt",
          "endsAt",
          "explanation",
          "rulesVersion",
          "dataSources"
        ],
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "exposureScore": {
            "type": "number",
            "description": "Heuristique versionnée, pas une probabilité sanitaire"
          },
          "explanation": {
            "type": "string"
          },
          "rulesVersion": {
            "type": "string"
          },
          "dataSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Candidate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "activityCode": {
            "type": "string"
          },
          "similarity": {
            "type": "number",
            "description": "Similarité vectorielle, pas une sécurité météo"
          },
          "embeddingVersion": {
            "type": "string"
          }
        }
      },
      "Preference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "favoriteCities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxWindKmh": {
            "type": "number",
            "minimum": 0,
            "maximum": 150
          },
          "maxEuropeanAqi": {
            "type": "number",
            "minimum": 0,
            "maximum": 500
          },
          "notifyEnabled": {
            "type": "boolean"
          }
        }
      },
      "Subscription": {
        "type": "object",
        "required": [
          "cityCode",
          "activityCode",
          "consentVersion"
        ],
        "properties": {
          "cityCode": {
            "type": "string"
          },
          "activityCode": {
            "type": "string"
          },
          "consentVersion": {
            "type": "string"
          },
          "threshold": {
            "type": "number"
          }
        }
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cityCode": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "LOW",
              "MODERATE",
              "HIGH",
              "UNKNOWN"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "ACKNOWLEDGED",
              "EXPIRED"
            ]
          },
          "ruleVersion": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preference"
          }
        }
      },
      "Report": {
        "type": "object",
        "properties": {
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "referenceKind": {
            "type": "string",
            "enum": [
              "OBSERVATION",
              "REANALYSIS",
              "NONE"
            ]
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "completeness": {
            "type": "string",
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "UNKNOWN"
            ]
          }
        }
      }
    }
  }
}